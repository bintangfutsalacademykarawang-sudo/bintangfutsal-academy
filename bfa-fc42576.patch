diff --git a/tests/backend-api-adapter-json.test.ts b/tests/backend-api-adapter-json.test.ts
new file mode 100644
index 0000000..3c44444
--- /dev/null
+++ b/tests/backend-api-adapter-json.test.ts
@@ -0,0 +1,117 @@
+/**
+ * BFA HUB — BACKEND API ADAPTER JSON & ERROR HANDLING UNIT TEST
+ */
+
+import assert from 'node:assert';
+
+// Simulated callBackendApi implementation with text parsing and safe error handling
+async function simulateCallBackendApi(
+  mockResponse: {
+    status: number;
+    statusText: string;
+    contentType: string;
+    bodyText: string;
+  }
+): Promise<any> {
+  const { status, statusText, contentType, bodyText } = mockResponse;
+  let data: any = null;
+
+  if (bodyText && bodyText.trim().length > 0) {
+    if (contentType.includes('application/json') || bodyText.trim().startsWith('{') || bodyText.trim().startsWith('[')) {
+      try {
+        data = JSON.parse(bodyText);
+      } catch (parseErr) {
+        // Safe warning, no throw of DOMException
+      }
+    }
+  }
+
+  if (status < 200 || status >= 300) {
+    const serverMsg =
+      data?.error?.message ||
+      data?.message ||
+      (typeof data?.error === 'string' ? data.error : null) ||
+      (bodyText && bodyText.length < 200 && !bodyText.includes('<html') ? bodyText.trim() : null) ||
+      `Layanan backend memberikan status HTTP ${status} (${statusText || 'Error'}).`;
+    throw new Error(serverMsg);
+  }
+
+  if (!data) {
+    throw new Error(`Tanggapan dari backend tidak berupa format JSON yang valid (HTTP ${status}).`);
+  }
+
+  return data;
+}
+
+console.log('======================================================================');
+console.log('BFA HUB — BACKEND API ADAPTER SAFE JSON ERROR HANDLING TESTS');
+console.log('======================================================================');
+
+(async () => {
+  // Case 1: Standard JSON success (200 OK)
+  console.log('--- 1. Valid JSON success response (200 OK) ---');
+  const res1 = await simulateCallBackendApi({
+    status: 200,
+    statusText: 'OK',
+    contentType: 'application/json',
+    bodyText: JSON.stringify({ success: true, token: 'bfa_token_123' }),
+  });
+  assert.strictEqual(res1.success, true);
+  assert.strictEqual(res1.token, 'bfa_token_123');
+  console.log('  ✓ PASS: Parsed valid JSON response successfully');
+
+  // Case 2: Structured JSON error response (403 Forbidden)
+  console.log('--- 2. Structured JSON error response (403 Forbidden) ---');
+  try {
+    await simulateCallBackendApi({
+      status: 403,
+      statusText: 'Forbidden',
+      contentType: 'application/json',
+      bodyText: JSON.stringify({
+        success: false,
+        error: { code: 'REGISTRATION_PENDING', message: 'Pendaftaran Anda sedang menunggu verifikasi Admin BFA.' },
+      }),
+    });
+    assert.fail('Should have thrown error');
+  } catch (err: any) {
+    assert.strictEqual(err.message, 'Pendaftaran Anda sedang menunggu verifikasi Admin BFA.');
+    assert.doesNotMatch(err.message, /Failed to execute 'json'/);
+    console.log('  ✓ PASS: Extracted structured error message cleanly without JSON parse crash');
+  }
+
+  // Case 3: Vercel / Nginx 404 HTML Error Page (Non-JSON)
+  console.log('--- 3. Non-JSON HTML 404 response ---');
+  try {
+    await simulateCallBackendApi({
+      status: 404,
+      statusText: 'Not Found',
+      contentType: 'text/html',
+      bodyText: '<html><head><title>404 Not Found</title></head><body><h1>404 Not Found</h1></body></html>',
+    });
+    assert.fail('Should have thrown error');
+  } catch (err: any) {
+    assert.strictEqual(err.message, 'Layanan backend memberikan status HTTP 404 (Not Found).');
+    assert.doesNotMatch(err.message, /Failed to execute 'json'/);
+    console.log('  ✓ PASS: Handled HTML 404 cleanly without throwing TypeError: Failed to execute json');
+  }
+
+  // Case 4: 500 Internal Server Error (Empty / Non-JSON body)
+  console.log('--- 4. Empty body 500 response ---');
+  try {
+    await simulateCallBackendApi({
+      status: 500,
+      statusText: 'Internal Server Error',
+      contentType: 'text/plain',
+      bodyText: '',
+    });
+    assert.fail('Should have thrown error');
+  } catch (err: any) {
+    assert.strictEqual(err.message, 'Layanan backend memberikan status HTTP 500 (Internal Server Error).');
+    assert.doesNotMatch(err.message, /Failed to execute 'json'/);
+    console.log('  ✓ PASS: Handled empty 500 response cleanly');
+  }
+
+  console.log('======================================================================');
+  console.log('RESULTS: 4 Passed, 0 Failed');
+  console.log('======================================================================');
+})();
