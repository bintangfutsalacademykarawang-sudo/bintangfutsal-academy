# BFA HUB — Konfigurasi Lingkungan Emulator Lokal
# Salin file ini ke .env atau .env.local untuk pengujian lokal terisolasi

# Target Environment: 'emulator' | 'staging' | 'production'
VITE_FIREBASE_ENV=emulator
VITE_USE_EMULATOR=true
VITE_FIREBASE_PROJECT_ID=demo-bfa-hub

# Host dan Port Emulator Lokal (sesuai firebase.json)
VITE_EMULATOR_HOST=127.0.0.1
VITE_EMULATOR_AUTH_PORT=9099
VITE_EMULATOR_FIRESTORE_PORT=8085

# ISOLASI KEAMANAN:
# Jangan pernah mengaktifkan VITE_ALLOW_PROD_IN_DEV di lingkungan lokal
# tanpa otorisasi tertulis dan pengawasan admin.
# VITE_ALLOW_PROD_IN_DEV=false
